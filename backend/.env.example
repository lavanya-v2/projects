# Database Configuration
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jira_daily_reports
DB_PORT=5432

# Redis Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379


# Reports Configuration
# Absolute path to directory where reports will be saved
REPORTS_PATH=/Users/username/projects/dsr-generator/reports

# Retained Excel/CSV uploads (one file per import). Use a persistent volume in production.
UPLOAD_PATH=/Users/username/projects/dsr-generator/uploads

# Report Window Configuration (Start of the 24h window in IST for "Today's" report)
REPORT_WINDOW_START_HOUR=18
REPORT_WINDOW_START_MINUTE=30

# Anthropic AI Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key

# Scheduler Configuration (cron expression)
CRON_EXPRESSION=30 18 * * *

# Server Configuration
PORT=3000
NODE_ENV=development

# Logging Configuration
# Options: DEBUG, INFO, WARN, ERROR
# Default: DEBUG in development, INFO in production
LOG_LEVEL=DEBUG

# Default Jira Lane Configuration (JSON)
# Used as fallback when a project has no project-level jira_lane_config set.
# Each key is a semantic role, value is an array of Jira status names.
DEFAULT_JIRA_LANE_CONFIG={"todo":["TODO","To Do","Backlog"],"in_progress":["In Progress","In Development"],"blocked":["Blocked","Impediment"],"in_review":["DEV COMPLETE","PR REVIEW","Code Review"],"qa":["QA","Testing","In QA"],"uat":["PO REVIEW","UAT","Acceptance Testing"],"done":["DONE","Done","Closed"],"reopened":["REOPENED","Reopened","Issues Found"]}

# Email Draft Configuration (for generateTwiceWeeklyEmail.ts script)
EMAIL_SENDER_NAME=Your Name
EMAIL_SENDER_ADDRESS=your.email@example.com
EMAIL_DEFAULT_CC=cc-recipient@example.com

# ── Notification Engine ──────────────────────────────────────────────────────
NOTIFICATIONS_ENABLED=true
EMAIL_PROVIDER=sendgrid          # sendgrid | smtp
EMAIL_FROM_NAME=Lens Notifications
EMAIL_FROM_ADDRESS=no-reply@v2solutions.com

# SendGrid (used when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# SMTP fallback (used when EMAIL_PROVIDER=smtp) — Outlook example:
# SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Claude Usage Collector ───────────────────────────────────────────────────
# Server-side secret mixed into the SHA-256 of ingest tokens before they are
# stored/compared. Set a strong random value in every environment BEFORE any
# user generates a token — changing it later invalidates all existing tokens.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COLLECTOR_TOKEN_PEPPER=change-me-collector-pepper

# Consent policy version. Bump to force every user to re-consent in the UI
# (e.g. when the data collected or the privacy notice changes).
COLLECTOR_CONSENT_VERSION=1.0

# When true, ingest only accepts a Claude org UUID that an admin has enabled in
# Admin > Monitored Orgs (multi-customer scoping). A push with no org (API-key
# mode) or an unenabled org is rejected. Set false to accept org-less data.
COLLECTOR_REQUIRE_ORG=true

# Folder the installer/zip endpoints serve the collector from. Defaults to the
# repo's tools/claude-usage-collector. Set this if prod deploys only backend/dist
# without the repo tree, so /api/collector/* can find the files.
# COLLECTOR_SOURCE_DIR=/opt/dsr-generator/tools/claude-usage-collector
