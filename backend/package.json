{
    "name": "dsr-generator-backend",
    "version": "1.0.0",
    "description": "Jira Daily Status Report Generator - Backend API",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "worker": "node dist/schedulerWorker.js",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "dev:worker": "ts-node-dev --respawn --transpile-only src/schedulerWorker.ts",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "typecheck": "tsc --noEmit",
        "check": "npm run typecheck && npm run lint && npm run format:check",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "test:run": "vitest run",
        "db:migrate": "sequelize-cli db:migrate",
        "db:migrate:undo": "sequelize-cli db:migrate:undo",
        "db:seed": "sequelize-cli db:seed:all",
        "db:seed:undo": "sequelize-cli db:seed:undo:all",
        "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
        "prod": "npm run build && pm2 start ecosystem.config.js",
        "prod:stop": "pm2 stop ecosystem.config.js",
        "prod:restart": "pm2 restart ecosystem.config.js",
        "prod:logs": "pm2 logs",
        "prod:monit": "pm2 monit",
        "batch:dsr": "ts-node -r dotenv/config --transpile-only src/jobs/batchDsrJob.ts",
        "batch:wsr": "ts-node -r dotenv/config --transpile-only src/jobs/batchWsrJob.ts",
        "report:productivity-reconciliation": "ts-node -r dotenv/config --transpile-only src/jobs/productivityReconciliationJob.ts",
        "report:quality-reconciliation": "ts-node -r dotenv/config --transpile-only src/jobs/qualityReconciliationJob.ts",
        "test:integration": "vitest run --config vitest.integration.config.ts"
    },
    "keywords": [
        "jira",
        "reporting",
        "ai",
        "claude"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@anthropic-ai/sdk": "^0.27.0",
        "@sendgrid/mail": "^8.1.6",
        "@socket.io/redis-adapter": "^8.3.0",
        "@types/archiver": "^7.0.0",
        "@types/bcrypt": "^6.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/sanitize-html": "^2.16.1",
        "@types/yargs": "^17.0.35",
        "archiver": "^7.0.1",
        "axios": "^1.13.5",
        "bcrypt": "^6.0.0",
        "bullmq": "^5.67.3",
        "cors": "^2.8.5",
        "csv-parse": "^6.2.1",
        "csv-parser": "^3.2.1",
        "dotenv": "^16.3.1",
        "exceljs": "^4.4.0",
        "express": "^4.18.2",
        "handlebars": "^4.7.9",
        "ioredis": "^5.9.2",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.1.1",
        "node-schedule": "^2.1.1",
        "nodemailer": "^8.0.5",
        "pg": "^8.16.3",
        "pg-hstore": "^2.3.4",
        "pptxgenjs": "^4.0.1",
        "reflect-metadata": "^0.2.2",
        "sanitize-html": "^2.17.6",
        "sequelize": "^6.37.5",
        "sequelize-typescript": "^2.1.6",
        "socket.io": "^4.8.3",
        "yargs": "^17.7.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/lodash": "^4.17.24",
        "@types/multer": "^2.1.0",
        "@types/node": "^25.0.3",
        "@types/node-schedule": "^2.1.5",
        "@types/nodemailer": "^8.0.0",
        "@types/pg": "^8.15.6",
        "@types/supertest": "^7.2.1",
        "@vitest/coverage-v8": "^2.1.8",
        "eslint": "^9.39.4",
        "globals": "^16.5.0",
        "pm2": "^5.3.0",
        "prettier": "^3.0.0",
        "sequelize-cli": "^6.6.3",
        "supertest": "^7.2.2",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.60.1",
        "vitest": "^2.1.8"
    }
}
